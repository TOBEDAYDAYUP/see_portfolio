# Copy to .env.local in the project root, then replace placeholders.
# Use Alpaca PAPER Trading keys only. Never commit .env.local.
ALPACA_PAPER_KEY_ID=PASTE_YOUR_PAPER_KEY_HERE
ALPACA_PAPER_SECRET_KEY=PASTE_YOUR_PAPER_SECRET_HERE

# Optional: SEC EDGAR annual financials in Research → Stock Reports.
# SEC requires a descriptive app name and YOUR actual contact email (no API key).
# Do not use the example address below as a real contact. Use your own address.
SEC_USER_AGENT="SEE Portfolio Research your-real-email@example.com"

# Optional SECONDARY financial data provider for missing SEC total shares.
# Requires your own FMP key and access to the stable/shares-float endpoint.
# The SEC companyfacts and official filing Inline XBRL are checked first.
# FMP_API_KEY=YOUR_OWN_FMP_API_KEY

# Optional: AI Assistant. This key is read only by the server route and is never
# exposed through a NEXT_PUBLIC_ variable. The current low-cost default model is
# deepseek-flash in non-thinking mode.
# DEEPSEEK_API_KEY=YOUR_OWN_DEEPSEEK_API_KEY
# DEEPSEEK_MODEL=deepseek-flash

# Production remains off by default because the app has no user authentication.
# Add authentication and rate limiting before explicitly enabling paid public use.
# DEEPSEEK_CHAT_ENABLED=true
